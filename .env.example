# Somente configurações do operador. Nunca envie este arquivo com chaves ao Git.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
RPC_TIMEOUT=8
# DATABASE_PATH=instance/scamshield.sqlite3
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# IA opcional via API local do Ollama. False mantém o resumo determinístico.
LLM_ENABLED=false
LLM_URL=http://127.0.0.1:11434/api/chat
LLM_MODEL=qwen2.5:1.5b
# Opcional: chave de um proxy privado compatível, somente no backend.
LLM_API_KEY=
AI_DAILY_LIMIT=20
